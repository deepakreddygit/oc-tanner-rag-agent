# Copy this file to .env and fill in your own values.
# .env is git-ignored -- never commit real API keys.

# Required. Get one at https://platform.openai.com/api-keys (see README for the
# step-by-step walkthrough). Used only for the chat model that generates answers.
OPENAI_API_KEY=

# Optional overrides -- sensible defaults are used if you leave these unset.

# Any OpenAI chat model your account has access to.
CHAT_MODEL=gpt-4o-mini

# 0.0 = deterministic, higher = more varied phrasing. Kept low for a support agent
# whose job is to report policy facts accurately, not to be creative.
CHAT_TEMPERATURE=0.0

# "huggingface" (default) runs a local, offline embedding model -- no API key, no
# per-call cost, but pulls in torch (a few hundred MB of RAM once loaded). "openai"
# uses OpenAI's hosted embeddings API instead -- no local model to load, which is what
# the public demo deployment uses on a memory-capped free-tier host. If you change
# this after already running scripts/ingest.py, re-run ingestion -- an index built
# with one provider isn't compatible with querying via the other.
EMBEDDING_PROVIDER=huggingface
# (see scripts/vectorstore.py)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# How many chunks to retrieve per question.
RETRIEVAL_K=4
